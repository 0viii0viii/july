<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 하드닝된 런타임에서는 이 권한이 없으면 마이크 요청이 창도 없이 즉시
	     거부된다. tauri가 signingIdentity "-"로 서명하면서 runtime 플래그를
	     켜므로(0x10002 adhoc,runtime) 반드시 있어야 한다. 이게 없어서 July가
	     시스템 설정의 마이크 목록에 나타나지 않았다. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
